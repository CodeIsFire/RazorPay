# Copy to .env and fill in. Never commit the real .env (already gitignored).
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# The live executor stays off until account_number is set too (see
# app/main.py's get_payout_executor) -- key_id/secret alone isn't enough.
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_PAYOUT_MODE=IMPS
# Seconds between automatic reconcile passes; 0 (default) means off, only
# manual POST /pipeline/reconcile runs. See app/config.py.
RR_RECONCILE_INTERVAL_SECONDS=0
# Groq powers the in-app assistant behind "Need help?". Empty (default) means
# the assistant stays off and the button falls back to its one-line blurb --
# same opt-in shape as the live executor. The key is used server-side only and
# is never sent to the browser; see app/groq_client.py.
GROQ_API_KEY=
# Chat model. Note the gpt-oss models emit hidden reasoning tokens that count
# against max_tokens, which is why RR_ASSISTANT_MAX_TOKENS has real headroom.
GROQ_MODEL=openai/gpt-oss-120b
# Poll RazorpayX for the status of in-flight payouts on a timer instead of only
# when someone clicks Sync payout status. Webhooks stay primary; this is the
# fallback that self-heals a missed delivery. Costs one API call per in-flight
# payout per pass, so 5s with 10 in flight is 120 calls/min. 0 = manual only.
RR_SYNC_PAYOUTS_INTERVAL_SECONDS=5
