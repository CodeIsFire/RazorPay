# Copy to .env and fill in. Never commit the real .env (already gitignored).
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# The live executor stays off until account_number is set too (see
# app/main.py's get_payout_executor) -- key_id/secret alone isn't enough.
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_PAYOUT_MODE=IMPS
# Seconds between automatic reconcile passes; 0 (default) means off, only
# manual POST /pipeline/reconcile runs. See app/config.py.
RR_RECONCILE_INTERVAL_SECONDS=0
# Groq powers the in-app assistant behind "Need help?". Empty (default) means
# the assistant stays off and the button falls back to its one-line blurb --
# same opt-in shape as the live executor. The key is used server-side only and
# is never sent to the browser; see app/groq_client.py.
GROQ_API_KEY=
# Chat model. Note the gpt-oss models emit hidden reasoning tokens that count
# against max_tokens, which is why RR_ASSISTANT_MAX_TOKENS has real headroom.
GROQ_MODEL=openai/gpt-oss-120b
# Poll RazorpayX for the status of in-flight payouts on a timer instead of only
# when someone clicks Sync payout status. Webhooks stay primary; this is the
# fallback that self-heals a missed delivery. Costs one API call per in-flight
# payout per pass, so 5s with 10 in flight is 120 calls/min. 0 = manual only.
RR_SYNC_PAYOUTS_INTERVAL_SECONDS=5

# --- AI cause classifier ---------------------------------------------------
# A second model, separate from the assistant above, used only to classify
# exception causes -- never to choose or dispatch an action. It is scored
# head-to-head against the deterministic rules by `python -m scripts.evaluate
# --stress --ai`; see app/stress_fixtures.py for why that comparison runs
# against adversarial cases rather than the standard fixture.
#
# Leave the key blank and the classifier is simply off: the rules-side
# evaluation still runs and every number in it still reproduces. That is a
# requirement rather than a convenience -- anyone cloning this repo has no
# keys, and the measured claims have to be checkable without them.

# Which provider the classifier asks: "gemini" or "anthropic". Named rather
# than inferred from whichever key happens to be set, so a published result
# always says which model produced it.
RR_AI_CLASSIFIER_PROVIDER=gemini

# Gemini (Google AI Studio). Note the free tier allows 20 generateContent
# calls per day per model, which is fewer than the stress set has rows --
# hence scripts/evaluate.py's --limit flag.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Messages API. ANTHROPIC_BASE_URL is overridable so the same client
# works against api.anthropic.com or a compatible gateway with no code change.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Below this the model's own stated confidence is treated as "don't know" and
# the row is left to the rules. A confident wrong cause is worse than no cause,
# because the cause is what picks the action.
RR_AI_CLASSIFIER_MIN_CONFIDENCE=0.6
