# OpenPanel analytics. Leave unset and the app sends nothing at all -- the SDK
# is never constructed. Only tab views are ever reported, and only the tab name
# (one of overview / exceptions / insights / audit) is sent; no URL, no element
# data, no ledger references. See src/lib/analytics.ts.
#
# This is a public client id, inlined into the bundle at build time. Do not put
# the OpenPanel client SECRET here -- a secret in a browser bundle is not one.
VITE_OPENPANEL_CLIENT_ID=
